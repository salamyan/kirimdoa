rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Email check helper
    function isAllowedEmail() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'salam@yayasanannabawi.com' ||
        request.auth.token.email.lower() == 'admin@yayasanannabawi.com' ||
        request.auth.token.email.lower() == 'tahfiz@yayasanannabawi.com' ||
        request.auth.token.email.lower() == 'yan.annabawi@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isAllowedEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation helper for Kirim Doa payload
    function isValidKirimDoa(data) {
      return data.keys().hasAll(['pengirim', 'nama', 'jenisHajat', 'cawangan', 'sumbangan', 'status', 'dibaca'])
        && data.keys().hasOnly(['pengirim', 'telefon', 'nama', 'jenisHajat', 'hajat', 'cawangan', 'sumbangan', 'status', 'dibaca', 'kaedah', 'sumber', 'createdAt'])
        && data.pengirim is string && data.pengirim.size() > 0 && data.pengirim.size() <= 80
        && data.nama is list && data.nama.size() >= 1 && data.nama.size() <= 3 && data.nama[0] is string
        && data.jenisHajat is string && data.jenisHajat.size() <= 100
        && data.cawangan in ['Semua cawangan', 'Machang', 'Shah Alam', 'Jerantut', 'Langkawi']
        && data.sumbangan is number && data.sumbangan >= 0
        && data.status in ['baru', 'menunggu', 'dibayar']
        && data.dibaca is bool;
    }

    // Koleksi kirimDoa
    // Orang awam boleh create doa baru secara percuma/ikhlas
    // Admin petugas boleh membaca, mengemaskini status bacaan, dan memadam
    match /kirimDoa/{docId} {
      allow create: if isValidId(docId)
        && isValidKirimDoa(incoming())
        && incoming().dibaca == false
        && incoming().createdAt == request.time;

      allow read: if isAdmin();

      allow update: if (
        isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['dibaca', 'status', 'sumbangan', 'kaedah', 'catatanPetugas'])
        && incoming().dibaca is bool
      ) || (
        // Membenarkan pengesahan sumbangan oleh penderma awam (FPX / DuitNow QR)
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'sumbangan', 'kaedah'])
        && incoming().status in ['baru', 'menunggu', 'dibayar']
        && incoming().sumbangan is number
        && incoming().sumbangan >= 0
      );

      allow delete: if isAdmin();
    }

    // Koleksi admins (pengurusan profil petugas)
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Koleksi settings (senarai konfigurasi emel admin & sistem)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
